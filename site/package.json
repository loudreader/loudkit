{
  "name": "loudkit-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for loudkit. Renders the repository's own docs/ tree; owns no prose of its own except the landing page.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "start": "npm run dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/starlight": "^0.41.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.2.4",
    "sharp": "^0.35.3",
    "starlight-llms-txt": "^0.11.0",
    "unist-util-visit": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
