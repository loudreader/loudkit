---
/*
  The NVIDIA CUDA card on the landing page.

  One table, every measured part, both models side by side under CUDA graphs.
  The eager figures, the times to first audio and the batch rows for every part
  are on the benchmark page; the card carries what a reader owning one of these
  cards wants first.

  Figures are quoted from docs/benchmarks.md and must be re-quoted when that
  page changes. The measurement-epoch note is in the section foot below the
  cards.
*/

// Every CUDA part measured end to end on 0.1.1 with CUDA graphs, sorted by the
// turbo figure; the Pascal card shows its eager path, the only one it has.
const hosts: Array<{ name: string; base: string; turbo: string; note?: string }> = [
  { name: 'RTX 3090', base: '8.55', turbo: '13.05' },
  { name: 'L4', base: '7.50', turbo: '11.93' },
  { name: 'A100', base: '7.68', turbo: '11.87' },
  { name: 'T4', base: '5.16', turbo: '7.95' },
  { name: 'GTX&nbsp;1080&nbsp;Ti', base: '2.26', turbo: '4.64', note: '&thinsp;*' },
  { name: 'Jetson Orin Nano', base: '1.85', turbo: '2.50' },
];

// Batch scaling, RTX 3090 with CUDA graphs, loudr-1-turbo: aggregate audio per
// second of wall clock across the whole batch, never the speed of one synthesis.
const batch: Array<[string, string]> = [
  ['42.0', 'batch 1'],
  ['121.8', 'batch 8'],
  ['145.5', 'batch 16'],
  ['154.2', 'batch 32'],
  ['155.0', 'batch 64'],
];
---

<div class="lk-card lk-card--feature">
  <p class="lk-req">requires an NVIDIA GPU</p>
  <h3>NVIDIA CUDA</h3>
  <div class="lk-metric">
    13.05&times;<span>real time with loudr-1-turbo, RTX 3090 with CUDA graphs; loudr-1 runs 8.55&times;</span>
  </div>
  {/* One line, and it says what the figures cannot: the range of hardware. */}
  <p>PyTorch, from an embedded board to a datacentre card. Both models, CUDA graphs on.</p>

  <table class="lk-bench">
    <thead>
      <tr>
        <th scope="col">Part</th>
        <th scope="col">loudr-1</th>
        <th scope="col">loudr-1-turbo</th>
      </tr>
    </thead>
    <tbody>
      {
        hosts.map(({ name, base, turbo, note }) => (
          <tr>
            <td set:html={name} />
            <td>{base}&times;</td>
            <td set:html={turbo + '&times;' + (note ?? '')} />
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="lk-bench-note">
    &thinsp;*&nbsp;Pascal cannot capture graphs: the 1080&nbsp;Ti figures are its eager path. Eager figures and time to first audio for every part are on the benchmark page.
  </p>

  <div class="lk-batch">
    <p class="lk-batch-label">Batch throughput, RTX 3090 with CUDA graphs, loudr-1-turbo</p>
    <p class="lk-batch-note">
      Many texts at once. Each number is the total audio produced per second of wall
      clock across the whole batch, not the speed of one synthesis. loudr-1 runs
      16.7&times; at batch&nbsp;1 and 57.3&times; at batch&nbsp;64 on the same card.
    </p>
    <div class="lk-batch-strip">
      {
        batch.map(([rtf, label]) => (
          <div class="lk-batch-step">
            <b>{rtf}&times;</b>
            <span>{label}</span>
          </div>
        ))
      }
    </div>
    <p class="lk-batch-note">
      <a href="/loudkit/benchmarks/#aggregate-throughput-at-batch-n-011-both-models">
        What it measures, and the full table
      </a>. The highest measured aggregate is 223.6&times;, turbo on an A100 at batch&nbsp;64.
    </p>
  </div>
</div>
