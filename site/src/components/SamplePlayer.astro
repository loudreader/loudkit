---
// The landing page and gallery share the same recorded sample metadata.
import rosterJson from '../../../docs/voices/roster/provenance.json';
import previewJson from '../../../docs/voices/preview/catalog.json';

interface Props {
  /** Roster name of the voice to play. */
  voice: string;
  /**
   * Show the "Reads a public-domain sentence from …" line. Off when the
   * page states the sentence once for a pair of players.
   */
  line?: boolean;
}

const { voice: wanted, line = true } = Astro.props;

const roster = rosterJson as Array<{
  name: string;
  language: string;
  gender: string;
  sample: { audio: string; work: string };
}>;

const preview = previewJson.find((v) => v.name === wanted);
const entry = preview ?? roster.find((v) => v.name === wanted);
if (!entry) throw new Error(`SamplePlayer: no voice named "${wanted}" in the roster`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const audio = preview
  ? `${base}/voices/preview/${preview.sample.short.audio}`
  : `${base}/voices/${roster.find((v) => v.name === wanted)!.sample.audio.split('/').pop()}`;
const displayName = preview?.display_name ?? entry.name;
const gender = entry.gender === 'F' ? 'female' : 'male';

// "Alice's Adventures in Wonderland (Lewis Carroll) — public domain" is the
// roster's shape. The page wants the title alone.
const work = preview ? '' : roster.find((v) => v.name === wanted)!.sample.work.split(/\s*[(—]/)[0].trim();
---

<div class="lk-sample not-content">
  <button
    type="button"
    class="lk-voice-play"
    data-src={audio}
    data-name={displayName}
    aria-label={`Play ${displayName}, ${entry.language}`}
  >
    <span class="lk-voice-icon" aria-hidden="true"></span>
  </button>
  <div class="lk-sample-body">
    <strong>{displayName}</strong>
    <span class="lk-sample-meta">
      {entry.language} <i>&middot;</i> {gender}
    </span>
    {line && !preview && <p class="lk-sample-line">Reads a public-domain sentence from {work}.</p>}
  </div>
</div>

<script>
  import '../scripts/voice-player.ts';
</script>
