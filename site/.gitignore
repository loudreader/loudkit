# Generated by scripts/sync-docs.mjs on every build: the Starlight content
# collection, rebuilt from docs/ and the repository root. Committing it would
# create a second copy of every documentation file, which is the one thing this
# site is arranged to avoid.
src/content/docs/
.docmap.json

# Also generated by scripts/sync-docs.mjs: the voice samples the roster grid
# plays, copied from docs/voices/roster/audio/. Same rule, same reason.
public/voices/

# Astro build output and caches.
dist/
.astro/
node_modules/
