{
  "name": "loudkit",
  "version": "0.1.0",
  "author": "LoudReader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loudreader/loudkit.git",
    "directory": "js"
  },
  "description": "loudkit text-to-speech over onnxruntime-node — the same engine, the same sampling law, no torch.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "onnx",
    "local"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "!dist/test/",
    "data/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-data.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "pretest": "node scripts/copy-data.mjs",
    "test": "tsc && node --test dist/test/*.test.js",
    "test:all": "npm run test && npm run test:fixture",
    "test:fixture": "node dist/test/run_conformance.js",
    "prepack": "npm run build && node scripts/check-pack.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
