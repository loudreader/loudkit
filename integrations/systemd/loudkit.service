# A user service that keeps the server running and the model loaded.
#
#     mkdir -p ~/.config/systemd/user
#     cp loudkit.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now loudkit
#     journalctl --user -fu loudkit
#
# It runs as your user, binds localhost and reads from your home directory.
# Put the checkpoint at ~/.local/share/loudkit/loudr-1.safetensors, or change
# LOUDKIT_CHECKPOINT below.
#
# `/usr/bin/env loudkit` finds `loudkit` on the PATH of the systemd user
# manager, which usually does not include a virtualenv or ~/.local/bin. If
# the service cannot find `loudkit`, put its absolute path in ExecStart, for
# example %h/.venv/bin/loudkit.
#
# PrivateDevices=true hides /dev/nvidia*, so this unit runs on the CPU even on
# a machine with an NVIDIA GPU. To use the GPU, remove that line.

[Unit]
Description=loudkit text-to-speech server
Documentation=https://github.com/loudreader/loudkit
After=network.target

[Service]
Type=simple
Environment=LOUDKIT_CHECKPOINT=%h/.local/share/loudkit/loudr-1.safetensors
# Unbuffered, so `journalctl --user -fu loudkit` shows the banner and any
# warning as they happen. Buffered logs arrive in 4 KB batches, and a service
# that is starting then looks hung.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env loudkit serve --checkpoint ${LOUDKIT_CHECKPOINT}
Restart=on-failure
RestartSec=5

# The service only reads a checkpoint and opens a localhost port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# No writable paths: the service reads a checkpoint, holds it in memory and
# answers on a socket.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
# ^ false: torch generates code at run time, and denying W^X stops it at import.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
